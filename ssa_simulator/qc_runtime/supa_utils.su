bool setKernelFunctionAttributes(
  suFuncAttributes& attrs, 
  const std::string& name, 
  const void* func
  // int const minThreadsPerBlock
) {
  suError_t supaStatus = suFuncGetAttributes(&attrs, func);
  if (supaStatus != suSuccess) {
    std::cerr
      << "[suFuncGetAttributes] failed for function: " << name
      << ", with error: " << suGetErrorString(supaStatus) << std::endl;
    return false;
  }

  // std::cout
  //   << "[" << name << "]: max threads per block " << attrs.maxThreadsPerBlock
  //   << ", local memory used " << attrs.localSizeBytes
  //   << ", registers used " << attrs.numRegs 
  //   << ", static shared memory used " << attrs.sharedSizeBytes
  //   << std::endl;

  // [BUG 2022.3.9 19:53] should be < instead of <=
  // if (attrs.maxThreadsPerBlock < minThreadsPerBlock) {
  //   std::cerr << "minimum threads per bslock allowed is: " << minThreadsPerBlock << std::endl;
  //   return false;
  // }

  return true;
}

bool allocateDeviceMemory(void** mem, uint64_t size, const std::string& name) {
  auto supaStatus = suMallocDevice(mem, size);
  if (supaStatus != suSuccess) {
    std::cerr << "[" << name << "] supa malloc failed with error " << suGetErrorString(supaStatus) << std::endl;

    goto error_entry_point;
  }

  // memset
  supaStatus = suMemset(*mem, 0, size);
  if (supaStatus != suSuccess) {
    std::cerr << "[" << name << "] supa memset failed with error " << suGetErrorString(supaStatus) << std::endl;

    goto error_entry_point;
  }

  return true;

error_entry_point:
  *mem = nullptr;
  return false;
}

bool allocateDeviceNumaMemory(void** mem, uint64_t* sizePerRegionPitch, uint64_t numRegions, uint64_t sizePerRegion, const std::string& name) {
  auto supaStatus = suNumaMallocDevice(mem, sizePerRegionPitch, numRegions, sizePerRegion);
  if (supaStatus != suSuccess) {
    std::cerr << "[" << name << "] supa malloc numa failed with error " << suGetErrorString(supaStatus) << std::endl;

    goto error_entry_point;
  }

  std::cout << "[" << name << "] region pitch/size is " << *sizePerRegionPitch << "/" << sizePerRegion << std::endl;

  // memset
  // supaStatus = suMemset(*mem, 0, size);
  // if (supaStatus != suSuccess) {
  //   std::cerr << "[" << name << "] supa memset failed with error " << suGetErrorString(supaStatus) << std::endl;

  //   goto error_entry_point;
  // }

  return true;

error_entry_point:
  *mem = nullptr;
  return false;
}

