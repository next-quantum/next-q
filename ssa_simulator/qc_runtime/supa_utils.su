bool resetDeviceMemory(void** mem, uint64_t size, const std::string& name) {
  // memset
  auto supaStatus = suMemset(*mem, 0, size);
  if (supaStatus != suSuccess) {
    std::cerr << "[" << name << "] supa memset failed with error " << suGetErrorString(supaStatus) << std::endl;

    goto error_entry_point;
  }

  return true;

error_entry_point:
  *mem = nullptr;
  return false;
}

void releaseDeviceMemory(void** mem, const std::string& name, bool noError) {
  if (*mem == nullptr) {
    return;
  }

  auto supaStatus = suFree(*mem);
  if (supaStatus != suSuccess && !noError) {
    std::cerr
      << "[" << name << "] supa free failed at address: 0x" << *mem
      << ", with error: " << suGetErrorString(supaStatus) << std::endl;
  }
  *mem = nullptr;
}

bool copyHostMemoryToDevice(void* dst, const void* src, uint64_t size, const std::string& name) {
  auto supaStatus = suMemcpy(dst, src, size, suMemcpyHostToDevice);
  if (supaStatus != suSuccess) {
    std::cerr
      << "[" << name << "] supa mem copy from host at address: 0x" << src
      << " to device at address: 0x" << dst
      << " of size: " << size
      << " failed, with error: " << suGetErrorString(supaStatus) << std::endl;
    return false;
  }

  supaStatus = suDeviceSynchronize();
  if (supaStatus != suSuccess) {
    std::cerr 
      << "[suDeviceSynchronize] device sync with error " 
      << suGetErrorString(supaStatus) 
      << std::endl;

    return false;
  }

  // std::cout << "[" << name << "] " << size << " byte data copied from host to device\n";
  return true;
}

bool copyDeviceMemoryToHost(void* dst, const void* src, uint64_t size, const std::string& name) {
  auto supaStatus = suMemcpy(dst, src, size, suMemcpyDeviceToHost);
  if (supaStatus != suSuccess) {
    std::cerr
      << "[" << name << "] supa mem copy from device at address: 0x" << src
      << " to host at address: 0x" << dst
      << " of size: " << size
      << " failed, with error: " << suGetErrorString(supaStatus) << std::endl;
    return false;
  }

  supaStatus = suDeviceSynchronize();
  if (supaStatus != suSuccess) {
    std::cerr 
      << "[suDeviceSynchronize] device sync with error " 
      << suGetErrorString(supaStatus) 
      << std::endl;

    return false;
  }

  return true;
}

uint64_t calculateBlocksPerGrid(
  uint64_t const threadsPerGrid, 
  uint64_t const threadsPerBlock
) {
  assert(threadsPerGrid >= threadsPerBlock);
  assert(threadsPerBlock > 0);

  uint64_t blocksPerGrid = (threadsPerGrid + threadsPerBlock - 1) / threadsPerBlock;

  return blocksPerGrid;
}